# Generation: an open Hugging Face model on your own vLLM server (infra/vllm/README.md).
# Local dev: http://127.0.0.1:8001/v1. On Vercel: the server's public HTTPS address.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=Qwen/Qwen3-4B-AWQ

# Optional fallback for when vLLM is unreachable (https://openrouter.ai/keys).
# With neither, the twin quotes retrieved evidence instead of generating.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=cohere/north-mini-code:free
# Comma-separated, tried in order when LLM_MODEL fails.
FALLBACK_LLM_MODELS=liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free

# Dense retrieval. Needs both; otherwise retrieval is lexical only.
# MONGODB_URI comes from https://cloud.mongodb.com, and HF_TOKEN needs the
# "Make calls to Inference Providers" permission (https://huggingface.co/settings/tokens).
MONGODB_URI=
HF_TOKEN=
# Local dev with infra/local (no accounts needed). Leave EMBEDDING_URL unset on Vercel.
# MONGODB_URI=mongodb://127.0.0.1:27019/?directConnection=true
# EMBEDDING_URL=http://127.0.0.1:8002/embed
MONGODB_DB=portfolio
MONGODB_COLLECTION=knowledge_chunks
MONGODB_VECTOR_INDEX=knowledge_vector

# Local dev only. On Vercel the frontend-to-backend binding injects this.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
