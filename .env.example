# OpenRouter API Key for LLM inference (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# Pinecone Vector Database (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=nabilprotfolio
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024

# Backend Server (local dev)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Server-side FastAPI URL (local dev). On Vercel Services this is injected via frontend→backend binding.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

INGEST_SECRET=generate_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:3000,https://thenabilman.vercel.app
